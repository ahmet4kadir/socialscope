# Copy to .env — the collector loads it automatically. Variables already set
# in the shell environment take precedence over values in .env.

# Path to the SQLite database file.
# Absolute, or relative to the repo root.
# Default when unset: <repo root>/data/socialscope.db
DB_PATH=

# Password gate for the web dashboard. Leave empty on localhost; set it on
# any deployment reachable by others (login page appears at /giris).
DASHBOARD_PASSWORD=

# Where the daily archive deepening stops, per account (default 100 posts).
ARCHIVE_CAP=
